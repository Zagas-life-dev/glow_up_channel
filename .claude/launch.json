{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "latest-glowup-channel",
        "start"
      ],
      "port": 3002
    },
    {
      "name": "web-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}